  "components": {
    "schemas": {
      "ActividadFiltro": {
        "properties": {
          "agenciaId": {
            "type": "string",
            "format": "uuid",
            "title": "Agenciaid"
          },
          "servicioId": {
            "type": "string",
            "format": "uuid",
            "title": "Servicioid"
          },
          "colaboradorId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Colaboradorid"
          }
        },
        "type": "object",
        "required": [
          "agenciaId",
          "servicioId",
          "colaboradorId"
        ],
        "title": "ActividadFiltro"
      },
      "AgenciaTablero": {
        "properties": {
          "agenciaId": {
            "type": "string",
            "format": "uuid",
            "title": "Agenciaid"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "departamento": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Departamento"
          },
          "municipio": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Municipio"
          },
          "activa": {
            "type": "boolean",
            "title": "Activa",
            "default": true
          },
          "servicioActivo": {
            "type": "boolean",
            "title": "Servicioactivo",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "agenciaId",
          "nombre"
        ],
        "title": "AgenciaTablero"
      },
      "CalendarioDemanda": {
        "properties": {
          "agenciaId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agenciaid"
          },
          "mes": {
            "type": "string",
            "title": "Mes"
          },
          "fuente": {
            "type": "string",
            "enum": [
              "REAL",
              "SIMULADA"
            ],
            "title": "Fuente"
          },
          "estadoPronostico": {
            "type": "string",
            "enum": [
              "DISPONIBLE",
              "HISTORIAL_INSUFICIENTE",
              "SOLO_CALENDARIO",
              "INCOMPLETO"
            ],
            "title": "Estadopronostico"
          },
          "dias": {
            "items": {
              "$ref": "#/components/schemas/DiaDemanda"
            },
            "type": "array",
            "title": "Dias"
          }
        },
        "type": "object",
        "required": [
          "agenciaId",
          "mes",
          "fuente",
          "estadoPronostico",
          "dias"
        ],
        "title": "CalendarioDemanda"
      },
      "CambiosEvento": {
        "properties": {
          "fecha": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fecha"
          },
          "tipo": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "FESTIVO_LOCAL",
                  "PAGO_SUBSIDIO_FAMILIAR",
                  "PAGO_NOMINA"
                ]
