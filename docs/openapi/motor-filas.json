        "tags": [
          "filas"
        ],
        "summary": "Personas delante de un turno; 404 si no está en la fila",
        "operationId": "posicion",
        "parameters": [
          {
            "name": "filaId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F-]{36}:[0-9a-fA-F-]{36}$"
            }
          },
          {
            "name": "turnoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
