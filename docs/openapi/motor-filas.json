      "delete": {
        "tags": [
          "filas"
        ],
        "summary": "Retira un turno cancelado o ausente; idempotente",
        "operationId": "retirar",
        "parameters": [
          {
            "name": "filaId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F-]{36}:[0-9a-fA-F-]{36}$"
            }
