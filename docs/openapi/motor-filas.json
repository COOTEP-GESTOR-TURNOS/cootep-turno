            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/SiguienteResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agencias/{agenciaId}/cierre": {
      "post": {
        "tags": [
          "agencias"
        ],
        "summary": "Vacía en paralelo las filas de la agencia y devuelve los turnos retirados (RN-13)",
        "operationId": "cerrar",
        "parameters": [
          {
            "name": "agenciaId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CierreRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CierreResponse"
                }
              }
            }
          }
        }
      }
    },
