{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenAPI definition",
    "version": "v0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "filas",
      "description": "Operaciones atómicas sobre las filas en Redis"
    }
  ],
  "paths": {
    "/api/v1/filas/{filaId}/turnos": {
      "get": {
        "tags": [
          "filas"
        ],
        "summary": "Consulta una página de turnos en espera según la regla K",
        "operationId": "listar",
        "parameters": [
          {
            "name": "filaId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F-]{36}:[0-9a-fA-F-]{36}$"
            }
          },
          {
            "name": "k",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 2,
              "maximum": 10,
              "minimum": 1
            }
          },
          {
            "name": "pagina",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "tamano",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20,
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaFilaResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "filas"
        ],
        "summary": "Encola un turno; idempotente por turnoId",
        "operationId": "encolar",
        "parameters": [
          {
            "name": "filaId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F-]{36}:[0-9a-fA-F-]{36}$"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EncolarRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/EncolarResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/filas/{filaId}/siguiente": {
      "post": {
        "tags": [
          "filas"
        ],
        "summary": "Entrega el siguiente turno según la regla K; 204 si la fila está vacía",
        "operationId": "siguiente",
        "parameters": [
          {
            "name": "filaId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F-]{36}:[0-9a-fA-F-]{36}$"
