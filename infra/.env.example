# Copie este archivo como infra/.env y cambie TODOS los valores.
# Use solo letras y números en las contraseñas: algunas van dentro de URLs de conexión.

# --- Motores de datos (compose.datos.yml) ---
POSTGRES_PASSWORD=cambiar_postgres
REDIS_PASSWORD=cambiar_redis
MONGO_ROOT_PASSWORD=cambiar_mongo_root
MONGO_APP_PASSWORD=cambiar_mongo_app
CLICKHOUSE_PASSWORD=cambiar_clickhouse

# --- Aplicaciones (compose.apps.yml) ---
# Token compartido entre los tres backends (cabecera X-Service-Token)
SERVICE_TOKEN=cambiar_token_entre_servicios
# Usar los datos simulados solo en el calendario de demanda.
DEMANDA_DEMO=false
# Secreto para firmar los JWT de acceso (32 caracteres o más)
JWT_SECRETO=cambiar_este_secreto_de_32_caracteres_o_mas

# Clave AES-256 para cifrar los secretos TOTP de MFA: 32 bytes en base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLAVE_CIFRADO_MFA=

# OpenID Connect con Google (Google Cloud > APIs y servicios > Credenciales > ID de cliente de OAuth, tipo web).
# URI de redireccionamiento autorizado: http://localhost:8080/api/v1/auth/oidc/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dirección pública de la web (retorno de Google y enlaces de los correos)
URL_PUBLICA=http://localhost:8080
# Cookie de sesión solo por HTTPS (localhost cuenta como seguro). false solo para probar por IP de la red.
COOKIE_SEGURA=true

# Correo saliente. Por defecto, el buzón de pruebas Mailpit (bandeja en http://localhost:8025).
# Para Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PUERTO=465, SMTP_SEGURO=true y una contraseña de aplicación.
SMTP_HOST=correo
SMTP_PUERTO=1025
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_REMITENTE=COOTEP Turno <no-responder@cootep-turno.test>

# Inicialización controlada del primer superadministrador
SUPERADMIN_EMAIL=superadmin@cootep-turno.test
# Mínimo 15 caracteres; se pide cambiarla y configurar MFA en el primer ingreso
SUPERADMIN_PASSWORD_TEMPORAL=

# Puertos publicados en el equipo. Windows (Hyper-V/WSL) a veces reserva rangos como 7968-8467
# después de reiniciar; véalos con: netsh interface ipv4 show excludedportrange protocol=tcp
# Si cambia PUERTO_WEB, cambie también URL_PUBLICA y el URI de redireccionamiento en Google.
PUERTO_BACKEND=3000
PUERTO_WEB=8080
PUERTO_CORREO=8025

# Rutas de los repositorios. Por defecto, los submódulos en ../apps/
# Si los clonó como carpetas hermanas de cootep-turno use, por ejemplo, ../../backend-principal
RUTA_BACKEND_PRINCIPAL=../apps/backend-principal
RUTA_MOTOR_FILAS=../apps/motor-filas
RUTA_ANALITICA=../apps/analitica
RUTA_WEB=../apps/web
