# Copie este archivo como infra/.env y cambie TODOS los valores.
# Use solo letras y números en las contraseñas: algunas van dentro de URLs de conexión.

# --- Motores de datos (compose.datos.yml) ---
POSTGRES_PASSWORD=cambiar_postgres
REDIS_PASSWORD=cambiar_redis
MONGO_ROOT_PASSWORD=cambiar_mongo_root
MONGO_APP_PASSWORD=cambiar_mongo_app
CLICKHOUSE_PASSWORD=cambiar_clickhouse

# --- Aplicaciones (compose.apps.yml) ---
# Token compartido entre los tres backends (cabecera X-Service-Token)
SERVICE_TOKEN=cambiar_token_entre_servicios
# Secreto para firmar los JWT de acceso (32 caracteres o más)
JWT_SECRETO=cambiar_este_secreto_de_32_caracteres_o_mas

# OpenID Connect (registre las apps en Google Cloud y en Microsoft Entra ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
OIDC_URL_BASE=http://localhost:8080

# Inicialización controlada del primer superadministrador
SUPERADMIN_EMAIL=superadmin@cootep-turno.test
# Mínimo 15 caracteres; se pide cambiarla y configurar MFA en el primer ingreso
SUPERADMIN_PASSWORD_TEMPORAL=

# Rutas de los repositorios. Por defecto, los submódulos en ../apps/
# Si los clonó como carpetas hermanas de cootep-turno use, por ejemplo, ../../backend-principal
RUTA_BACKEND_PRINCIPAL=../apps/backend-principal
RUTA_MOTOR_FILAS=../apps/motor-filas
RUTA_ANALITICA=../apps/analitica
RUTA_WEB=../apps/web
